{
  "buildCommand": "npm run build",
  "outputDirectory": ".vercel/output",
  "framework": "sveltekit",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    },
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}